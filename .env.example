# Required — Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Required — Spotify Developer App credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — Override primary Groq model slug (defaults to openai/gpt-oss-120b with dynamic fallback)
GROQ_MODEL=

# Optional — Override Spotify OAuth callback URI (defaults to <origin>/api/spotify/callback)
SPOTIFY_REDIRECT_URI=
